<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#0a0a0a" width="560px">
    <mj-section padding="32px 20px 16px">
      <mj-column>
        <mj-image src="{{ logo_url }}" alt="{{ project_name }}" width="150px" align="center" padding="0" />
      </mj-column>
    </mj-section>

    <mj-section background-color="#171717" border="1px solid #262626" border-radius="12px" padding="40px 32px">
      <mj-column>
        <mj-text align="center" font-size="20px" font-weight="700" color="#fafafa" padding="0 0 16px">Reset your password</mj-text>
        <mj-text align="center" font-size="15px" line-height="24px" color="#a1a1a1" padding="0 8px 8px">Hi {{ username }}, we received a request to reset the password for your {{ project_name }} account.</mj-text>
        <mj-button align="center" font-size="15px" font-weight="600" background-color="#1554e3" border-radius="8px" color="#ffffff" href="{{ link }}" padding="28px 0 20px" inner-padding="14px 32px">Reset password</mj-button>
        <mj-text align="center" font-size="13px" line-height="20px" color="#71717a" padding="0 8px 4px">Or copy and paste this link into your browser:</mj-text>
        <mj-text align="center" font-size="13px" line-height="20px" color="#5b8dff" padding="0 8px 24px"><a href="{{ link }}" style="color:#5b8dff;">{{ link }}</a></mj-text>
        <mj-divider border-color="#262626" border-width="1px" padding="0 0 20px" />
        <mj-text align="center" font-size="13px" line-height="20px" color="#71717a" padding="0 8px">This link expires in {{ valid_hours }} hours. If you didn't request this, you can safely ignore this email.</mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="20px 20px 32px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#52525b" padding="0">{{ project_name }}</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
