<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#0a0a0a" width="560px">
    <mj-section padding="32px 20px 16px">
      <mj-column>
        <mj-image src="{{ logo_url }}" alt="{{ project_name }}" width="150px" align="center" padding="0" />
      </mj-column>
    </mj-section>

    <mj-section background-color="#171717" border="1px solid #262626" border-radius="12px" padding="40px 32px">
      <mj-column>
        <mj-text align="center" font-size="20px" font-weight="700" color="#fafafa" padding="0 0 16px">Welcome to {{ project_name }}</mj-text>
        <mj-text align="center" font-size="15px" line-height="24px" color="#a1a1a1" padding="0 8px 24px">An account has been created for you. Here are your sign-in details:</mj-text>

        <mj-table padding="0 0 24px" css-class="account-table">
          <tr>
            <td style="padding: 10px 16px; background-color:#0a0a0a; border:1px solid #262626; border-radius:8px 8px 0 0; font-size:13px; color:#71717a;">Email</td>
            <td style="padding: 10px 16px; background-color:#0a0a0a; border:1px solid #262626; border-left:none; border-radius:0 8px 0 0; font-size:13px; color:#fafafa; text-align:right;">{{ email }}</td>
          </tr>
          <tr>
            <td style="padding: 10px 16px; background-color:#0a0a0a; border:1px solid #262626; border-top:none; border-radius:0 0 0 8px; font-size:13px; color:#71717a;">Password</td>
            <td style="padding: 10px 16px; background-color:#0a0a0a; border:1px solid #262626; border-top:none; border-left:none; border-radius:0 0 8px 0; font-size:13px; color:#fafafa; text-align:right;">{{ password }}</td>
          </tr>
        </mj-table>

        <mj-text align="center" font-size="13px" line-height="20px" color="#71717a" padding="0 8px 8px">For your security, sign in and change this password as soon as possible.</mj-text>
        <mj-button align="center" font-size="15px" font-weight="600" background-color="#1554e3" border-radius="8px" color="#ffffff" href="{{ link }}" padding="20px 0 0" inner-padding="14px 32px">Go to {{ project_name }}</mj-button>
      </mj-column>
    </mj-section>

    <mj-section padding="20px 20px 32px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#52525b" padding="0">{{ project_name }}</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
