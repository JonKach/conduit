Content-Type: {{contentType}}

{
  "message": "Hello?",
  "model": "google_genai:gemini-3.1-flash-lite"
}

### [AUTH] Stream — missing message field (expect 422)
POST {{baseUrl}}/agents/{{agentId}}/threads/{{threadId}}/stream
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

{
  "model": "google_genai:gemini-3.1-flash-lite"
}

### [AUTH] Stream — missing model field (expect 422)
POST {{baseUrl}}/agents/{{agentId}}/threads/{{threadId}}/stream
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

{
  "message": "Hello?"
}

### [AUTH] Stop a running stream (expect 400 if nothing is running)
POST {{baseUrl}}/agents/{{agentId}}/threads/{{threadId}}/stop_stream
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

### [AUTH] List files uploaded to a thread
GET {{baseUrl}}/agents/{{agentId}}/threads/{{threadId}}/files
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

### [AUTH] Recent threads across all agents
GET {{baseUrl}}/threads/recent
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

### [AUTH] Delete thread by ID
DELETE {{baseUrl}}/agents/{{agentId}}/threads/{{threadId}}
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

### [AUTH] Delete thread — not found (expect 404)
DELETE {{baseUrl}}/agents/{{agentId}}/threads/nonexistentThreadId
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

### [AUTH] Delete thread — wrong agent_id (expect 404)
DELETE {{baseUrl}}/agents/wrongAgentId/threads/{{threadId}}
