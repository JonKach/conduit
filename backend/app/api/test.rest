# =============================================================================
# API Test Suite
# Base URL and shared variables
# =============================================================================
# Prerequisites: Install the REST Client extension for VS Code
# Update @baseUrl, @superuserToken, @userToken, @agentId, @threadId as needed

@baseUrl = http://localhost:8000/api/v1
@contentType = application/json

# Tokens — populate these after running the login requests below
@superuserToken = <placeholder>
@userToken = <placeholder>

# IDs — populate these after creating resources
@agentId = <placeholder>
@threadId = <placeholder>
@userId = <placeholder>


# =============================================================================
# AUTH — Login
# =============================================================================

### Login as superuser → copy access_token into @superuserToken
# @name loginSuperuser
POST {{baseUrl}}/login/access-token
Content-Type: application/x-www-form-urlencoded

username=admin@example.com&password=changethis

### Register a new user (if needed for testing) → copy access_token into @userToken
POST {{baseUrl}}/users/signup
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "userpassword",
  "full_name": "Regular User"
}

### Login as regular user → copy access_token into @userToken
# @name loginUser
POST {{baseUrl}}/login/access-token
Content-Type: application/x-www-form-urlencoded

username=user@example.com&password=userpassword


# =============================================================================
# USERS
# =============================================================================

### [SUPERUSER] List all users
GET {{baseUrl}}/users/
Authorization: Bearer {{superuserToken}}
Content-Type: {{contentType}}

### [SUPERUSER] List users — with pagination
GET {{baseUrl}}/users/?skip=0&limit=10
Authorization: Bearer {{superuserToken}}
Content-Type: {{contentType}}

### [SUPERUSER] Create a new user
POST {{baseUrl}}/users/
Authorization: Bearer {{superuserToken}}
Content-Type: {{contentType}}

{
  "email": "user@example.com",
  "password": "userpassword",
  "full_name": "New User",
  "is_active": true,
  "is_superuser": false
}

### [SUPERUSER] Create user — duplicate email (expect 400)
POST {{baseUrl}}/users/
Authorization: Bearer {{superuserToken}}
Content-Type: {{contentType}}

{
  "email": "newuser@example.com",
  "password": "securepassword123",
  "full_name": "Duplicate User",
  "is_active": true,
  "is_superuser": false
}

### [SUPERUSER] Create user — invalid email (expect 422)
POST {{baseUrl}}/users/
Authorization: Bearer {{superuserToken}}
Content-Type: {{contentType}}

{
  "email": "not-an-email",
  "password": "securepassword123",
  "full_name": "Bad Email User"
}

### [SUPERUSER] Create user — password too short (expect 422)
POST {{baseUrl}}/users/
Authorization: Bearer {{superuserToken}}
Content-Type: {{contentType}}

{
  "email": "shortpw@example.com",
  "password": "short",
  "full_name": "Short Password User"
}

### [ANY USER] Register (public signup)
POST {{baseUrl}}/users/signup
Content-Type: {{contentType}}

{
  "email": "selfsignup@example.com",
  "password": "securepassword123",
  "full_name": "Self Signup User"
}

### [ANY USER] Register — duplicate email (expect 400)
POST {{baseUrl}}/users/signup
Content-Type: {{contentType}}

{
  "email": "selfsignup@example.com",
  "password": "securepassword123",
  "full_name": "Duplicate Signup"
}

### [AUTH] Get current user (me)
GET {{baseUrl}}/users/me
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

### [AUTH] Update current user (me)
PATCH {{baseUrl}}/users/me
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

{
  "full_name": "Updated Name",
  "email": "updated@example.com"
}

### [AUTH] Update current user — email already taken by another user (expect 409)
PATCH {{baseUrl}}/users/me
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

{
  "email": "admin@example.com"
}

### [AUTH] Change own password
PATCH {{baseUrl}}/users/me/password
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

{
  "current_password": "userpassword",
  "new_password": "newpassword456"
}

### [AUTH] Change own password — wrong current password (expect 400)
PATCH {{baseUrl}}/users/me/password
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

{
  "current_password": "wrongpassword",
  "new_password": "newpassword456"
}

### [AUTH] Change own password — same as current (expect 400)
PATCH {{baseUrl}}/users/me/password
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

{
  "current_password": "userpassword",
  "new_password": "userpassword"
}

### [SUPERUSER] Get user by ID
GET {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{superuserToken}}
Content-Type: {{contentType}}

### [SUPERUSER] Get user by ID — not found (expect 404)
GET {{baseUrl}}/users/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{superuserToken}}
Content-Type: {{contentType}}

### [REGULAR USER] Get another user by ID — insufficient privileges (expect 403)
GET {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

### [SUPERUSER] Update a user by ID
PATCH {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{superuserToken}}
Content-Type: {{contentType}}

{
  "email": "patchedbysuper@example.com",
  "full_name": "Patched By Super",
  "is_active": true,
  "is_superuser": false,
  "password": "newpassword789"
}

### [SUPERUSER] Update user — email conflict (expect 409)
PATCH {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{superuserToken}}
Content-Type: {{contentType}}

{
  "email": "admin@example.com",
  "full_name": "Conflict Test",
  "is_active": true,
  "is_superuser": false,
  "password": "newpassword789"
}

### [SUPERUSER] Update user — user not found (expect 404)
PATCH {{baseUrl}}/users/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{superuserToken}}
Content-Type: {{contentType}}

{
  "email": "ghost@example.com",
  "full_name": "Ghost",
  "is_active": true,
  "is_superuser": false,
  "password": "newpassword789"
}

### [SUPERUSER] Delete a user by ID
DELETE {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{superuserToken}}
Content-Type: {{contentType}}


### [SUPERUSER] Delete user — not found (expect 404)
DELETE {{baseUrl}}/users/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{superuserToken}}
Content-Type: {{contentType}}



### [SUPERUSER] Delete self as superuser (expect 403)
DELETE {{baseUrl}}/users/{{userId}}
Authorization: Bearer {{superuserToken}}
Content-Type: {{contentType}}

### [AUTH] Delete own account
DELETE {{baseUrl}}/users/me
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

### [AUTH] Delete own account — superuser self-delete (expect 403)
DELETE {{baseUrl}}/users/me
Authorization: Bearer {{superuserToken}}
Content-Type: {{contentType}}

### Unauthenticated request — no token (expect 401)
GET {{baseUrl}}/users/me


### [AUTH] Check that a token is valid
POST {{baseUrl}}/login/test-token
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

# =============================================================================
# AGENTS
# =============================================================================

### [AUTH] List own agents
GET {{baseUrl}}/agents/me
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

### [AUTH] List own agents — with pagination
GET {{baseUrl}}/agents/me?skip=0&limit=5
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

### [AUTH] List public agents (regular user sees only is_public=true)
GET {{baseUrl}}/agents/public
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

### [SUPERUSER] List public agents (superuser sees all agents)
GET {{baseUrl}}/agents/public
Authorization: Bearer {{superuserToken}}
Content-Type: {{contentType}}

### [AUTH] Create a new agent
POST {{baseUrl}}/agents/
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

{
  "name": "Private Agent",
  "description": "A test agent",
  "system_prompt": "You are a helpful assistant.",
  "tools_config": [],
  "is_public": false
}

### [AUTH] Create a public agent
POST {{baseUrl}}/agents/
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

{
  "name": "Public Agent",
  "description": "Visible to everyone",
  "system_prompt": "You are a public assistant.",
  "tools_config": [],
  "is_public": true
}

### [AUTH] Create agent — missing required field (name) (expect 422)
POST {{baseUrl}}/agents/
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

{
  "description": "No name agent",
  "system_prompt": "You are an assistant.",
  "tools_config": [],
  "is_public": false
}

### [AUTH] Create agent — name too short (expect 422)
POST {{baseUrl}}/agents/
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

{
  "name": "",
  "system_prompt": "You are an assistant.",
  "tools_config": [],
  "is_public": false
}

### [AUTH] Get agent by ID (owner access)
GET {{baseUrl}}/agents/{{agentId}}
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

### [SUPERUSER] Get agent by ID (superuser access)
GET {{baseUrl}}/agents/{{agentId}}
Authorization: Bearer {{superuserToken}}
Content-Type: {{contentType}}

### [AUTH] Get agent — not found (expect 404)
GET {{baseUrl}}/agents/nonexistentAgentId12345
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

### [AUTH] Get private agent owned by another user (expect 403)
# Requires agentId to belong to a different user and is_public=false
GET {{baseUrl}}/agents/{{agentId}}
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

### [AUTH] Update agent (full update, owner)
PUT {{baseUrl}}/agents/{{agentId}}
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

{
  "name": "Updated Agent Name",
  "description": "Updated description",
  "system_prompt": "You are an updated assistant.",
  "tools_config": ["web_search"],
  "is_public": true
}

### [AUTH] Update agent — not found (expect 404)
PUT {{baseUrl}}/agents/nonexistentAgentId12345
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

{
  "name": "Ghost Update",
  "description": "Should not exist",
  "system_prompt": "N/A",
  "tools_config": [],
  "is_public": false
}

### [AUTH] Delete agent (owner)
DELETE {{baseUrl}}/agents/{{agentId}}
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

### [SUPERUSER] Delete any agent
DELETE {{baseUrl}}/agents/{{agentId}}
Authorization: Bearer {{superuserToken}}
Content-Type: {{contentType}}

### [AUTH] Delete agent owned by another user (expect 403)
DELETE {{baseUrl}}/agents/{{agentId}}
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

### [AUTH] Delete agent — not found (expect 404)
DELETE {{baseUrl}}/agents/nonexistentAgentId12345
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}


### [AUTH] Marketplace sorted by popularity (how many users added each agent)
GET {{baseUrl}}/agents/public?sort=popular
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

### [AUTH] Add another user's public agent to my list
POST {{baseUrl}}/agents/added-public
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

{
  "agent_id": "{{agentId}}"
}

### [AUTH] Add own agent to my list (expect 403)
# Requires agentId to belong to the current user
POST {{baseUrl}}/agents/added-public
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

{
  "agent_id": "{{agentId}}"
}

### [AUTH] List public agents I've added
GET {{baseUrl}}/agents/added-public
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

### [AUTH] Remove a public agent from my list
DELETE {{baseUrl}}/agents/added-public/{{agentId}}
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

### [AUTH] List an agent's skill names
GET {{baseUrl}}/agents/{{agentId}}/skills
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

### [AUTH] Get a skill's content
GET {{baseUrl}}/agents/{{agentId}}/skills/research
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

# =============================================================================
# THREADS  (nested under /agents/{agent_id}/threads)
# =============================================================================

### [AUTH] Create a new thread
POST {{baseUrl}}/agents/{{agentId}}/threads/
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

{
  "name": "User's thread"
}

### [AUTH] Create thread — default name (omit name field)
POST {{baseUrl}}/agents/{{agentId}}/threads/
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

{}

### [AUTH] Create thread — agent not found (expect 404)
POST {{baseUrl}}/agents/nonexistentAgentId12345/threads/
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

{
  "name": "Thread for ghost agent"
}

### [AUTH] Create thread — no access to private agent (expect 403)
# agentId must be a private agent owned by a different user
POST {{baseUrl}}/agents/{{agentId}}/threads/
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

{
  "name": "Unauthorized thread"
}

### [AUTH] List threads for an agent
GET {{baseUrl}}/agents/{{agentId}}/threads/
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

### [AUTH] List threads — with pagination
GET {{baseUrl}}/agents/{{agentId}}/threads/?skip=0&limit=5
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

### [AUTH] Get thread by ID
GET {{baseUrl}}/agents/{{agentId}}/threads/{{threadId}}
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

### [AUTH] Get thread — not found (expect 404)
GET {{baseUrl}}/agents/{{agentId}}/threads/nonexistentThreadId
Authorization: Bearer {{userToken}}
Content-Type: {{contentType}}

### [AUTH] Get thread — wrong agent_id (expect 404)
GET {{baseUrl}}/agents/wrongAgentId/threads/{{threadId}}
