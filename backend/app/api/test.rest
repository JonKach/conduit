###
# 1. First, get a token (assuming you have a user created)
# @name login
POST http://localhost:8000/api/v1/login/access-token
Content-Type: application/x-www-form-urlencoded

username=admin@example.com&password=changethis

###
# 2. Use the token to create an agent
# @name create_agent
@token = {{login.response.body.access_token}}

POST http://localhost:8000/api/v1/agents/ HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "Test Agent 2",
    "description": "This is a second test agent.",
    "system_prompt": "You are a helpful testing assistant.",
    "tools_config": {},
    "is_public": false
}

###
# 3. Use the token to create a thread for the agent
@agent_id = {{create_agent.response.body.id}}

POST http://localhost:8000/api/v1/agents/{{agent_id}}/threads/
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "Test Thread"
}

###

DELETE http://localhost:8000/api/v1/agents/{{agent_id}}
Authorization: Bearer {{token}}